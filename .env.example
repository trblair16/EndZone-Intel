# Copy this file to .env and fill in your league's details.
# Never commit the real .env file - it contains your ESPN session cookies.

# Found in your league's ESPN URL: .../leagueId=123456...
LEAGUE_ID=1225958279

# Season year, e.g. 2026
YEAR=2026

# Only needed for private leagues. Get these from your browser's
# DevTools -> Application/Storage -> Cookies -> fantasy.espn.com
ESPN_S2=
SWID=

# Your team's id within the league (used for "my roster"). Optional -
# leave blank until you know it; the app runs fine without it.
TEAM_ID=5
